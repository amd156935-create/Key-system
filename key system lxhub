            Text = text,
            Duration = duration or 3
        })
    end)
end

local function ValidateKey(key)
    local validationUrl = "https://new.pandadevelopment.net/api/v1/keys/validate"
    local payload = {
        ServiceID = LINKVERTISE_SERVICE_ID,
        HWID = tostring(hwid()),
        Key = tostring(key),
    }

    local success, response = pcall(function()
        return frequest({
            Url = validationUrl,
            Method = "POST",
            Headers = {
                ["User-Agent"] = "Roblox/Exploit",
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode(payload),
        })
    end)

    if success and response and response.Success then
        local decodeSuccess, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if decodeSuccess and data and data.Authenticated_Status == "Success" then
            return true
        end
    end

    return false
end

local function GetKeyLink()
    return "https://new.pandadevelopment.net/getkey/" .. LINKVERTISE_SERVICE_ID .. "?hwid=" .. tostring(hwid())
end


local function Discord()
    local httpRequest = (syn and syn.request) or (http and http.request) or request
    local inviteCode = string.match(DISCORD_INVITE, "discord[.]com/invite/([%w%-]+)")

    if not httpRequest or not inviteCode then
        fsetclipboard(DISCORD_INVITE)
        Notify("Join Discord manually", "Invite copied to clipboard.", 5)
        return
    end

    local success = pcall(function()
        httpRequest({
            Url = "http://127.0.0.1:6463/rpc?v=1",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Origin"] = "https://discord.com"
            },
            Body = HttpService:JSONEncode({
                cmd = "INVITE_BROWSER",
                args = { code = inviteCode },
                nonce = HttpService:GenerateGUID(false)
            })
        })
    end)

    if success then
        Notify("Discord invite opened", "Join the server in Discord, then return here.", 5)
    else
        fsetclipboard(DISCORD_INVITE)
        Notify("Join Discord manually", "Invite copied to clipboard.", 5)
    end
end

